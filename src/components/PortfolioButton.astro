<style>
  @keyframes border-pulse {
    0%, 100% {
      border-color: rgba(var(--color-text-base), 0.3);
      box-shadow: 0 0 0 0 rgba(var(--color-text-base), 0);
    }
    50% {
      border-color: rgba(var(--color-text-base), 0.8);
      box-shadow: 0 0 12px rgba(var(--color-text-base), 0.2);
    }
  }

  @keyframes border-pulse-light {
    0%, 100% {
      border-color: rgba(var(--color-fill), 0.6); /* Use skin-fill (usually dark in light mode logic?) No, skin-fill is bg. Need text-base or specialized color on light mode. */
      /* Actually, let's use a specific vibrant color for light mode if possible, or just stronger opacity of base text which is dark */
      border-color: rgba(0, 0, 0, 0.4); 
      box-shadow: 0 0 0 0 rgba(0, 0, 0, 0);
    }
    50% {
      border-color: rgba(0, 0, 0, 1);
      box-shadow: 0 0 15px rgba(0, 0, 0, 0.3);
    }
  }

  .animate-border-pulse {
    animation: border-pulse 3s ease-in-out infinite;
  }

  /* Specific override for light mode if the theme is NOT dark */
  :global(html:not(.dark)) .animate-border-pulse {
     animation-name: border-pulse-light;
     /* Also maybe bump the border width visually or just opacity? */
  }
</style>

